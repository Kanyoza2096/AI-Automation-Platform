# Copy to .env.staging and populate via a secure secret manager/operator.
# Never commit .env.staging or put real values in shell history.
ENVIRONMENT=staging
LOG_LEVEL=INFO
GUARDIAN_ENABLED=false
PORT=10000
# Honcho starts the worker process, but it remains inert until explicitly enabled.
KDO_ENGINEERING_WORKER_ENABLED=false
SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_STAGING_SERVICE_ROLE_KEY
# Add other application-required provider secrets only if staging exercises them.
# GEMINI_KEY=
# MASTER_API_TOKEN=
# ENCRYPTION_KEY=

# Worker remains disabled until live runtime isolation and governance gates pass.
# This ref is the existing KDO Testing Supabase project, not production.
KDO_ENGINEERING_EXPECTED_SUPABASE_PROJECT_REF=kkzshurcmcptleyqjgzo
KDO_ENGINEERING_DATABASE_URL=REPLACE_WITH_STAGING_POOLER_DSN
KDO_ENGINEERING_WORKER_ID=engineering-worker-staging-1
KDO_ENGINEERING_TENANT_ID=kdo-engineering-staging
KDO_ENGINEERING_WORKSPACE_ID=kdo-engineering-staging
# Create a dedicated kny_ token in this staging workspace with write permission.
# Set ACTOR_ID to that token's persisted api_tokens.id; never paste the token here.
KDO_ENGINEERING_WORKER_ACTOR_ID=REPLACE_WITH_API_TOKEN_RECORD_ID
KDO_ENGINEERING_WORKER_API_TOKEN=REPLACE_WITH_STAGING_KNY_TOKEN
KDO_ENGINEERING_WORKER_HOST_FACTORY=services.kdo_engineering_staging_host:build_host_arguments
KDO_ENGINEERING_SOURCE_REPOSITORY_PATH=/app
KDO_ENGINEERING_MANAGED_WORKSPACE_ROOT=/tmp/kdo-engineering-workspaces
# Workspace-level operator allowlist; not task/model-selected.
KDO_ENGINEERING_WORKER_REPAIR_CAPABILITIES=backend,services
# Must be a real immutable image digest before enabling the worker.
KDO_ENGINEERING_WORKER_IMAGE=REPLACE_WITH_REGISTRY_IMAGE_AT_SHA256_DIGEST
KDO_ENGINEERING_DOCKER_BINARY=docker
KDO_ENGINEERING_TEST_PROFILE=pytest
KDO_ENGINEERING_TEST_TIMEOUT_SECONDS=120
KDO_ENGINEERING_MAX_REPAIR_ATTEMPTS=1
KDO_ENGINEERING_DOCKER_MEMORY_LIMIT=1g
KDO_ENGINEERING_DOCKER_CPU_LIMIT=1.0
KDO_ENGINEERING_DOCKER_PIDS_LIMIT=128
KDO_ENGINEERING_LEASE_SECONDS=300
KDO_ENGINEERING_POLL_SECONDS=2
KDO_ENGINEERING_MAX_POLL_SECONDS=30
