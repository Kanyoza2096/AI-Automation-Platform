# Copy to .env.staging and populate via a secure secret manager/operator.
# Never commit .env.staging or put real values in shell history.
ENVIRONMENT=staging
LOG_LEVEL=INFO
GUARDIAN_ENABLED=false
PORT=10000
# Honcho starts the worker process, but it remains inert until explicitly enabled.
KDO_ENGINEERING_WORKER_ENABLED=false
SUPABASE_URL=https://YOUR-STAGING-PROJECT.supabase.co
SUPABASE_ANON_KEY=REPLACE_WITH_STAGING_ANON_KEY
SUPABASE_SERVICE_ROLE_KEY=REPLACE_WITH_STAGING_SERVICE_ROLE_KEY
# Add other application-required provider secrets only if staging exercises them.
# GEMINI_KEY=
# MASTER_API_TOKEN=
# ENCRYPTION_KEY=
