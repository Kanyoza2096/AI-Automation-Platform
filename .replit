modules = ["python-3.11"]
[agent]
expertMode = true
stack = "BEST_EFFORT_FALLBACK"
integrations = ["python_gemini_ai_integrations:1.0.0"]

[nix]
channel = "stable-25_05"
packages = ["gitFull", "iana-etc", "libxcrypt", "playwright-driver", "xcodebuild", "zlib"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Start application"

[[workflows.workflow]]
name = "Start application"
author = "agent"

[workflows.workflow.metadata]
outputType = "webview"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "pip install -r requirements.txt -q && ENVIRONMENT=development gunicorn main:app --bind 0.0.0.0:5000 --worker-class eventlet --workers 1 --timeout 120 --log-level info"
waitForPort = 5000

[[ports]]
localPort = 5000
externalPort = 80

[userenv]

[userenv.shared]
ENVIRONMENT = "development"
LOG_LEVEL = "INFO"
PORT = "5000"
GUARDIAN_ENABLED = "true"
GUARDIAN_AUTO_FIX = "true"
